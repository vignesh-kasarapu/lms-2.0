# Copy to .env and fill in. All EXPO_PUBLIC_ values are embedded in the
# client bundle (visible to anyone with the app) — this is fine here since
# this is a public OAuth client (PKCE, no client secret ever touches the
# device) and a base URL, never a secret. See ../MIGRATION_PLAN.md §2.

# backend-py's base URL. Use your machine's LAN IP (not localhost) when
# testing on a physical device — the phone can't resolve the dev machine's
# localhost.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Same Entra tenant as the web app. The mobile client id is a SEPARATE,
# public-client App Registration (no secret) — not yet created; see
# ../MIGRATION_PLAN.md §2's note on this. Leave blank to fall back to
# dev-login only (see EXPO_PUBLIC_DEV_AUTH_BYPASS_ENABLED below).
EXPO_PUBLIC_ENTRA_TENANT_ID=
EXPO_PUBLIC_ENTRA_MOBILE_CLIENT_ID=

# Must exactly match backend-py's ENTRA_MOBILE_REDIRECT_URI env var (the
# exchange endpoint uses its own server-side redirect_uri, not one supplied
# by the client) and app.json's "scheme".
EXPO_PUBLIC_MOBILE_REDIRECT_URI=lms://auth

# Mirrors backend-py's DEV_AUTH_BYPASS_ENABLED — shows a "Dev sign-in"
# button that calls POST /api/auth/dev-login instead of the real Entra PKCE
# flow. Only ever works if the backend's own guard also has it enabled and
# ENVIRONMENT != production (server-side enforced either way).
EXPO_PUBLIC_DEV_AUTH_BYPASS_ENABLED=true
