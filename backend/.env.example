# --- Server ---
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000
CLIENT_BASE_URL=http://localhost:5173

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lms_db
DB_USER=lms_user
DB_PASSWORD=change_me
DB_SSL=false

# --- Microsoft Entra ID (OIDC) ---
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:4000/api/auth/callback

# --- Application session ---
SESSION_JWT_SECRET=change_me_to_a_long_random_string
SESSION_COOKIE_NAME=lms_session

# --- Dev/test auth bypass (LMS-006) ---
# MUST default to disabled. Application refuses to start if true alongside NODE_ENV=production.
DEV_AUTH_BYPASS_ENABLED=false
DEV_AUTH_BYPASS_EMPLOYEE_CODE=

# --- Exchange Online SMTP (OAuth2 client credentials) ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_TENANT_ID=
SMTP_CLIENT_ID=
SMTP_CLIENT_SECRET=
SMTP_FROM_ADDRESS=leave-system@yourorg.com

# --- Org defaults (only used as seed data, never hardcoded in logic) ---
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_LEAVE_YEAR_START=04-01
