# Read by docker-compose.yml (both to seed the mysql container and to
# configure the backend service). Copy to .env at the repo root and fill in
# real values before running `docker compose up`. This is separate from
# backend/.env, which is for running the backend directly on your host.

# --- MySQL container ---
MYSQL_ROOT_PASSWORD=change_me_root
DB_NAME=lms_db
DB_USER=lms_user
DB_PASSWORD=change_me

# --- Backend ---
# NODE_ENV=development keeps sequelize.sync() creating/updating tables on
# boot, since this repo has no migration files yet. Only switch to
# production once real migrations exist, or the schema will never be created.
NODE_ENV=development
APP_BASE_URL=http://localhost:4000
CLIENT_BASE_URL=http://localhost
SESSION_JWT_SECRET=change_me_to_a_long_random_string
SESSION_COOKIE_NAME=lms_session

ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:4000/api/auth/callback

# Dev/test auth bypass (LMS-006) — must be false if NODE_ENV=production.
DEV_AUTH_BYPASS_ENABLED=true
DEV_AUTH_BYPASS_EMPLOYEE_CODE=EMP001

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_TENANT_ID=
SMTP_CLIENT_ID=
SMTP_CLIENT_SECRET=
SMTP_FROM_ADDRESS=leave-system@yourorg.com

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_LEAVE_YEAR_START=04-01
