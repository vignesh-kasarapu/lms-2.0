ENVIRONMENT=development
PORT=8000
APP_BASE_URL=http://localhost:8000
CLIENT_BASE_URL=http://localhost:5173

# --- Database (MySQL) --- separate DB name from the Node app; see MIGRATION_PLAN.md
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lms_2_0_py
DB_USER=root
DB_PASSWORD=root
DB_SSL=false

# --- Microsoft Entra ID (OIDC) — web ---
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:8000/api/auth/callback

# --- Microsoft Entra ID — mobile public client (separate app registration) ---
ENTRA_MOBILE_CLIENT_ID=
ENTRA_MOBILE_REDIRECT_URI=lms://auth

# --- Application session ---
SESSION_JWT_SECRET=change_me_to_a_long_random_string
SESSION_COOKIE_NAME=lms_session

# --- Dev/test auth bypass ---
DEV_AUTH_BYPASS_ENABLED=true
DEV_AUTH_BYPASS_EMPLOYEE_CODE=EMP001

# --- Outbound mail (SMTP) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
SMTP_FROM_ADDRESS=leave-system@yourorg.com

# --- Org defaults ---
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_LEAVE_YEAR_START=04-01
